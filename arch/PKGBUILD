# Maintainer: CharOfString <root@charofstring.cc>
pkgname=gxde-dict-git
pkgver=1.0.2
pkgrel=1
pkgdesc='GXDE Youdao dictionary'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/gxde-dict"
license=('GPL-3.0-or-later')
depends=('dtk2widget-qt6-git' 'dtk6core-git' 'qt6-base' 'qt6-multimedia' 'libx11' 'libxtst'
         'hicolor-icon-theme' 'libgcc' 'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja' 'pkgconf' 'qt6-tools' 'dtk6gui-git' 'libxext')
provides=('gxde-dict')
conflicts=('gxde-dict')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
